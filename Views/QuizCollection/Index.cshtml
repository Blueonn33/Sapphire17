@{
    ViewData["Title"] = "Тестове";
}
@model IEnumerable<QuizCollection>;

<head>
    <link href="~/css/site.css" rel="stylesheet" />
    <link href="~/css/QuizCollection/QuizCollectionStyles.css" rel="stylesheet" />
</head>
<body>
    <div>
        <section class="quiz-content-container container mt-5">
            <a class="quiz-add-btn btn fs-4" asp-action="Create" asp-controller="QuizCollection">+ нов тест</a>
            <div class="quizzes-container">
                @foreach (var quizCollection in Model)
                {
                    <div class="quiz-collection-content-container mb-5">
                        <div class="quiz-collection-image-container mt-3 m-5">
                            <img src="@Url.Action("GetQuizCollectionImage", "QuizCollection", new { quizCollectionId = quizCollection.Id })"
                                 class="img-fluid quiz-collection-image p-3" />
                        </div>
                        <div class="ms-3 mt-5 quiz-collection-text-container mb-5">
                            <p class="fs-2 fw-bold m-0 quiz-collection-name">@quizCollection.Name</p>
                            <p class="fs-3 m-0 quiz-collection-description">@quizCollection.Description</p>
                        </div>
                        <div class="quiz-collection-open-container me-5">
                            <a class="btn btn-light btn-lg">Отвори</a>
                        </div>
                    </div>
                }
            </div>
        </section>
    </div>
</body>