@{
    ViewData["Title"] = "Започни теста";
}
@model IEnumerable<Quiz>

<head>
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/Quiz/QuizStartTestStyles.css" />
</head>

<body>
    <div class="start-quiz-container container mt-5">
        @foreach (var quiz in Model)
        {
            <div class="start-quiz-form mb-5" data-quiz-id="@quiz.QuizCollectionId" data-points="@quiz.Points">
                <div class="start-quiz-element" id="quiz-container-@quiz.Id">
                    <header class="p-3">
                        <h3 class="pt-3 fs-1" id="quiz-question-text-@quiz.Id">@quiz.Question</h3>
                        <hr class="quiz-line" />
                    </header>

                    <div class="quiz-get-answer-container">
                        <div class="quiz-question-container">
                            <button type="button" class="btn" data-bs-toggle="modal" data-bs-target="#show-answer-modal-@quiz.Id">
                                <img class="question-image p-3" src="~/Images/question.png" width="80" />
                            </button>
                        </div>
                        <hr class="quiz-line" />
                    </div>

                    <div class="quiz-answers-container mx-5 mt-5" data-correct-answer="@quiz.CorrectAnswer">
                        <div class="quiz-option-container">
                            <div class="quiz-option-letter-container m-3">
                                <p class="quiz-option-letter text-dark fs-3 m-0">А</p>
                            </div>
                            <button class="btn btn-lg btn-light m-3 px-5 quiz-option-button">@quiz.AnswerA</button>
                        </div>

                        <div class="quiz-option-container">
                            <div class="quiz-option-letter-container m-3">
                                <p class="quiz-option-letter text-dark fs-3 m-0">Б</p>
                            </div>
                            <button class="btn btn-lg btn-light m-3 px-5 quiz-option-button">@quiz.AnswerB</button>
                        </div>

                        <div class="quiz-option-container">
                            <div class="quiz-option-letter-container m-3">
                                <p class="quiz-option-letter text-dark fs-3 m-0">В</p>
                            </div>
                            <button class="btn btn-lg btn-light m-3 px-5 quiz-option-button">@quiz.AnswerC</button>
                        </div>

                        <div class="quiz-option-container">
                            <div class="quiz-option-letter-container m-3">
                                <p class="quiz-option-letter text-dark fs-3 m-0">Г</p>
                            </div>
                            <button class="btn btn-lg btn-light m-3 px-5 quiz-option-button">@quiz.AnswerD</button>
                        </div>
                    </div>
                </div>

                <div class="quiz-buttons-container container my-5">
                    <a asp-action="Index" asp-controller="QuizCollection" class="btn btn-lg btn-info ms-5">Край на теста</a>
                    <a class="btn btn-lg btn-light me-5 btn-next-question">Следващ въпрос</a>
                </div>

                <div class="modal fade" id="show-answer-modal-@quiz.Id" tabindex="-1" aria-labelledby="showAnswerModalLabel" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h1 class="modal-title fs-5 text-dark">Отговор</h1>
                                <button type="button" class="btn-close bg-light" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                <p class="text-dark fs-3">@quiz.CorrectAnswer</p>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">ОК</button>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        }
    </div>
</body>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            let score = 0;
            let totalScore = 0;

            const quizForms = document.querySelectorAll('.start-quiz-form');

            quizForms.forEach(form => {
                form.style.display = "none";
                totalScore += parseInt(form.getAttribute('data-points'));
            });

            const quizCollectionId = quizForms[0].getAttribute('data-quiz-id');

            let currentIndex = 0;
            quizForms[currentIndex].style.display = 'block';

            document.querySelectorAll('.quiz-option-button').forEach(button => {
                button.addEventListener('click', function () {

                    button.classList.add('quiz-option-button-clicked');

                    const container = this.closest('.quiz-answers-container');
                    const correctAnswer = container.getAttribute('data-correct-answer');

                    const quizForm = this.closest('.start-quiz-form');
                    const questionPoints = parseInt(quizForm.getAttribute('data-points'));

                    const allButtons = container.querySelectorAll('.quiz-option-button');

                    allButtons.forEach(btn => btn.disabled = true);

                    allButtons.forEach(btn => {
                        const isCorrect = btn.textContent.trim() === correctAnswer.trim();

                        btn.classList.remove('btn-light');

                        if (isCorrect) {
                            btn.classList.add('btn-success');
                        } else {
                            btn.classList.add('btn-danger');
                        }
                    });

                    if (this.textContent.trim() === correctAnswer.trim()) {
                        score += questionPoints;
                    }
                });
            });

            document.querySelectorAll('.btn-next-question').forEach(button => {
                button.addEventListener('click', function () {

                    quizForms[currentIndex].style.display = 'none';
                    currentIndex++;

                    if (currentIndex < quizForms.length) {
                        quizForms[currentIndex].style.display = 'block';
                    } else {
                        addQuizResult(quizCollectionId, score, totalScore);
                    }
                });
            });
        });

        function addQuizResult(quizCollectionId, score, totalScore) {

            $.post("@Url.Action("Create", "QuizResult")?quizCollectionId=" + quizCollectionId,
                {
                    Score: score,
                    TotalScore: totalScore,
                    quizCollectionId: quizCollectionId,
                    TakenAt: Date.now()
                },
                function () {
                    window.location.href = `/QuizResult/Index?quizCollectionId=${quizCollectionId}`;
                })
                .fail(function () {
                    alert("error");
                });
        }
    </script>
}

